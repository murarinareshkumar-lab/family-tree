PORT=3001
NODE_ENV=development

# Google Service Account Credentials (Base64 string or JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=eyJhbGciOi...

# 3 Google Sheets (Can be 3 separate Sheet IDs or 1 Sheet ID with 3 tabs)
GOOGLE_SHEET_ID_SURNAME=your_ft_surname_details_sheet_id
GOOGLE_SHEET_ID_USER=your_ft_user_details_sheet_id
GOOGLE_SHEET_ID_ADMIN=your_ft_admin_sheet_id
# (If all 3 are tabs in one spreadsheet, you can just use GOOGLE_SHEET_ID)
# GOOGLE_SHEET_ID=your_single_google_sheet_id

# Private Admin Portal URL Access (NO password login needed)
# Your private URL: https://your-domain.vercel.app/admin?key=YOUR_SECRET_KEY
ADMIN_SECRET_KEY=family_vault_admin_secret_key_2026

# Base URL for links and verification emails
APP_URL=https://family-tree-lineage.vercel.app

# Email & Verification
SUPPORT_EMAIL=support@familytree.local
RECAPTCHA_SECRET=valid

# SMTP Configuration (for sending real emails to users' inboxes)
# For Gmail: Use smtp.gmail.com with port 587 and an App Password (16 chars, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM="Family Tree Portal <your_email@gmail.com>"
